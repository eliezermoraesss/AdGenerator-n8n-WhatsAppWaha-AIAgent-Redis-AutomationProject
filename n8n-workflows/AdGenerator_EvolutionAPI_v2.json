      "parameters": {
        "jsCode": "let text = $input.first().json.output || '';\n\ntext = text\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed_array = [];\n\ntry {\n  parsed_array = JSON.parse(text);\n} catch (e) {\n  parsed_array = [];\n}\n\n// garante que os campos existem (opcional, mas recomendado)\nparsed_array = parsed_array.map(item => ({\n  texto_formatado: item.texto_formatado || '',\n  chatId: item.chatId || null,\n  instance: item.instance || null,\n  imagem_url_converted: item.imagem_url_converted || null,\n  id_agendamento: item.id_agendamento || null\n}));\n\nreturn parsed_array.map(item => ({\n  json: item\n}));"
