    {
      "parameters": {
        "jsCode": "\nconst ACCEPTED_EXTENSIONS = ['jpg', 'jpeg', 'png'];\nlet items = $input.first().json.items || [];\nfor (const item of items) {\n  const imageUrl = item.imagem_url;\n  if (!imageUrl || typeof imageUrl !== 'string') {\n    item.imagem_url_converted = null;\n    continue;\n  }\n  const [baseUrl, queryString] = imageUrl.split('?');\n  const parts = baseUrl.split('.');\n  if (parts.length < 2) {\n    item.imagem_url_converted = imageUrl;\n    continue;\n  }\n  const currentExtension = parts.pop().toLowerCase();\n  if (ACCEPTED_EXTENSIONS.includes(currentExtension)) {\n    item.imagem_url_converted = imageUrl;\n  } else {\n    const newBaseUrl = [...parts, 'jpg'].join('.');\n    item.imagem_url_converted = queryString ? `${newBaseUrl}?${queryString}` : newBaseUrl;\n  }\n}\nreturn [{ json: { items } }];\n"
      },
