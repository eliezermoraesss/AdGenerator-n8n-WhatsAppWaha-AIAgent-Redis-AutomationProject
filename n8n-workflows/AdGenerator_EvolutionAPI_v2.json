    {
      "parameters": {
        "jsCode": "\nfunction parseMoney(value) {\n\tif (!value) return 0;\n\treturn parseFloat(value.toString().replace(\"R$\", \"\").replace(/\\./g, \"\").replace(\",\", \".\").trim());\n}\nfunction formatBRL(value) {\n\treturn \"R$ \" + value.toFixed(2).replace(\".\", \",\").replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\");\n}\n\nlet items = $input.first().json.items || [];\nfor (let item of items) {\n    let rawDesconto = item.desconto;\n    let precoStr = item.preco_atual || '0';\n    let preco = parseMoney(precoStr);\n    let novoPreco = preco;\n\n    if (rawDesconto) {\n        let isPercent = false;\n        let valorDesconto = 0;\n        if (typeof rawDesconto === \"string\") {\n            let desc = rawDesconto.trim();\n            if (desc.includes(\"%\")) {\n                isPercent = true;\n                valorDesconto = parseFloat(desc.replace(\"%\", \"\").replace(\",\", \".\"));\n            } else {\n                valorDesconto = parseFloat(desc.replace(\",\", \".\"));\n            }\n        }\n        else if (typeof rawDesconto === \"number\") {\n            valorDesconto = rawDesconto;\n        }\n\n        if (!isNaN(valorDesconto)) {\n            if (isPercent) novoPreco = preco - (preco * valorDesconto / 100);\n            else novoPreco = preco - valorDesconto;\n        }\n    }\n    if (novoPreco < 0) novoPreco = 0;\n    item.preco_atual = formatBRL(novoPreco);\n}\nreturn [{ json: { items } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
