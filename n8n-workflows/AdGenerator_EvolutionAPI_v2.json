    {
      "parameters": {
        "jsCode": "const text = $('Mapear Campos').first().json.message || '';\nconst urls = text.match(/(https?:\\/\\/[^\\s]+)/g) || [];\nlet cupom = null;\nconst cupomMatch = text.match(/\\b(?:cupom|codigo|código)\\s*:?\\s*([a-z0-9\\-]+)/i);\nif (cupomMatch && cupomMatch[1]) cupom = cupomMatch[1].toUpperCase();\n\nlet desconto = null;\nconst percentMatch = text.match(/(\\d+(?:[.,]\\d+)?)\\s*%/);\nif (percentMatch) desconto = percentMatch[1] + \"%\";\nelse {\n  const numberMatch = text.match(/\\b(?:desconto|off|descontar|desc)\\s*(\\d+(?:[.,]\\d+)?)/i);\n  if (numberMatch) desconto = parseFloat(numberMatch[1].replace(\",\", \".\"));\n}\n\nreturn urls.map(url => ({\n    json: {\n        url,\n        cupom,\n        desconto,\n        chatId: $('Mapear Campos').first().json.chatId,\n        instance: $('Mapear Campos').first().json.session\n    }\n}));\n"
      },
