    {
      "parameters": {
        "jsCode": "const hoje = new Date();\nconst diaSemana = hoje.getDay(); // 0 = Domingo, 6 = Sábado\n\nlet mensagem = \"\";\n\nswitch (diaSemana) {\n  case 0:\n    mensagem = `BOM DIAAA ‼️\nBOM DOMINGO E BORA COMEÇAR COM OS ACHADOS❗🔥🛒`;\n    break;\n\n  case 1:\n    mensagem = `BOM DIAAA E ÓTIMA SEGUNDA-FEIRA PESSOAL‼️\n\nBORA COMEÇAR COM OS ACHADOS DE HOJE❗🔥`;\n    break;\n\n  case 2:\n    mensagem = `BOM DIAA E ÓTIMA TERÇA-FEIRA PESSOAL❗\n\nBORA COMEÇAR COM OS ACHADOS DE HOJE❗🔥`;\n    break;\n\n  case 3:\n    mensagem = `BOM DIA PESSOAL! ☀️\nÓTIMA QUARTA PRA GENTE 🗯\n\nPODEMOS COMEÇAR COM OS NOSSOS ACHADOS⁉️ 🗣`;\n    break;\n\n  case 4:\n    mensagem = `BOM DIA PESSOAL! 🗯\n\nÓTIMA QUINTA, BORA COMEÇAR COM OS ACHADOS DE HOJE ‼️`;\n    break;\n\n  case 5:\n    mensagem = `BOM DIA GALEEERA‼️ \nEXCELENTE SEXTA PARA VOCÊS❗🙏🏼\n\nBORA COMEÇAR COM AS OFERTAS❗ 🛍️🤩`;\n    break;\n\n  case 6:\n    mensagem = `BOM DIA‼️ \nEXCELENTE SÁBADO PARA VOCÊS❗🙏🏼\n\nBORA COMEÇAR COM AS OFERTAS 🔥🔥`;\n    break;\n}\n\n// retorna no formato que o n8n espera\nreturn [\n  {\n    json: {\n      mensagem: mensagem\n    }\n  }\n];"
      },
